# Copy this file to .env and fill in the value. Never commit .env.
#
# LLM_API_KEY is the access token for the OpenAI-compatible chat completions
# endpoint used by the screening and extraction stages:
#
#     Provider: Obuda University GenAI gateway (Open WebUI in front of Ollama)
#     Endpoint: https://genai.uni-obuda.hu/api/chat/completions
#     Model:    gpt-oss:120b
#
# The endpoint requires an account on the university gateway. If you are outside
# the university, point LLM_API_URL at any OpenAI-compatible endpoint that serves
# the same model and supply the matching key.

LLM_API_KEY=

# Optional. Defaults to the university endpoint above when unset.
# LLM_API_URL=
